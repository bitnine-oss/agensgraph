 "Peter"   | ["Fido", "Ozzy"]
 "Timothy" | []
(3 rows)

-- a SQL jsonb function consuming a Cypher COLLECT result
SELECT jsonb_array_length(t.dogs) AS n
FROM (MATCH (p:Person {name: 'Peter'})
      RETURN COLLECT { MATCH (p)-[:HAS_DOG]->(d:Dog) RETURN d.name } AS dogs) t;
