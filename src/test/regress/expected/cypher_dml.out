EXPLAIN (costs off)
MATCH (s:nd)-[r1:kin ONLY]-(m:nd)-[r2:kid]-(x:nd)
RETURN s.id AS s, r1.p AS r1, m.id AS m, r2.p AS r2, x.id AS x;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Hash Join
   Hash Cond: (kid."end" = x.id)
   ->  Hash Join
         Hash Cond: (kid.start = m.id)
         ->  Append
               ->  Seq Scan on kid
               ->  Seq Scan on kid kid_1
         ->  Hash
               ->  Hash Join
                     Hash Cond: (m.id = kin."end")
                     ->  Seq Scan on nd m
                     ->  Hash
                           ->  Hash Join
                                 Hash Cond: (s.id = kin.start)
                                 ->  Seq Scan on nd s
                                 ->  Hash
                                       ->  Append
                                             ->  Seq Scan on kin
                                             ->  Seq Scan on kin kin_1
   ->  Hash
         ->  Seq Scan on nd x
