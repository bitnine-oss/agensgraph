-- 14. plan shape
-- Naming an item costs nothing: the key becomes the item's own expression, so
-- the plan is the one the qualified spelling gives.
EXPLAIN (COSTS OFF)
MATCH (p:person) RETURN p.id AS x, p.name AS name ORDER BY x * -1, name;
