OPTIONAL MATCH (n)-[r]->(p), (m)-[s]->(q)
RETURN n.name AS n, type(r) AS r, p.name AS p,
       m.name AS m, type(s) AS s, q.name AS q
ORDER BY n, p, m, q;
     n      |    r    |     p      |     m      |    s    |     q      
------------+---------+------------+------------+---------+------------
 "anybody"  | "knows" | "nobody"   | "someone"  | "knows" | "somebody"
