RETURN nodes(p)[-1].sec AS last, nodes(p)[-4].sec AS first, nodes(p)[-5] IS NULL AS oob,
       id(relationships(p)[-1]) = id(relationships(p)[2]) AS rel_last,
       [x IN nodes(p)[-2..] | x.sec] AS last2, [x IN nodes(p)[..-1] | x.sec] AS but_last;
