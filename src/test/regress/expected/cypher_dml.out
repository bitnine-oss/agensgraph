EXPLAIN MATCH (n:n1) DETACH DELETE (n);
                                                  QUERY PLAN                                                   
---------------------------------------------------------------------------------------------------------------
 Graph Delete  (cost=38.30..46003.33 rows=1200 width=0)
   ->  Nested Loop CypherDelete Join  (cost=38.30..46003.33 rows=1200 width=64)
         ->  Seq Scan on n1 n  (cost=0.00..22.00 rows=1200 width=32)
         ->  Aggregate  (cost=38.30..38.31 rows=1 width=32)
               ->  Nested Loop  (cost=0.00..38.25 rows=19 width=30)
                     ->  Function Scan on unnest v  (cost=0.00..0.01 rows=1 width=8)
                     ->  Append  (cost=0.00..38.03 rows=21 width=30)
                           ->  Seq Scan on ag_edge e_1  (cost=0.00..0.00 rows=1 width=30)
                                 Filter: ((start = v.id) OR ("end" = v.id))
                           ->  Bitmap Heap Scan on e1 e_2  (cost=8.38..18.96 rows=10 width=30)
                                 Recheck Cond: ((start = v.id) OR ("end" = v.id))
                                 ->  BitmapOr  (cost=8.38..8.38 rows=10 width=0)
                                       ->  Bitmap Index Scan on e1_start_idx  (cost=0.00..4.19 rows=5 width=0)
                                             Index Cond: (start = v.id)
                                       ->  Bitmap Index Scan on e1_end_idx  (cost=0.00..4.19 rows=5 width=0)
                                             Index Cond: ("end" = v.id)
                           ->  Bitmap Heap Scan on e2 e_3  (cost=8.38..18.96 rows=10 width=30)
                                 Recheck Cond: ((start = v.id) OR ("end" = v.id))
                                 ->  BitmapOr  (cost=8.38..8.38 rows=10 width=0)
                                       ->  Bitmap Index Scan on e2_start_idx  (cost=0.00..4.19 rows=5 width=0)
                                             Index Cond: (start = v.id)
                                       ->  Bitmap Index Scan on e2_end_idx  (cost=0.00..4.19 rows=5 width=0)
                                             Index Cond: ("end" = v.id)
