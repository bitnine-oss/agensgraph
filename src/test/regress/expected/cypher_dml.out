-- combined with AND / OR
MATCH (person:Person)
WHERE EXISTS { (person)-[:HAS_DOG]->(:Dog) }
  AND EXISTS { (person)-[:HAS_CAT]->(:Cat) }
RETURN person.name AS name ORDER BY name;
