EXPLAIN (VERBOSE, COSTS OFF)
MATCH (a:person {id: 1})-[x:knows*1..2]->(b:person)
WITH x[0] AS x1, x[1] AS x2 ORDER BY x2 RETURN x1;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Subquery Scan on _agens_default_s
   Output: _agens_default_s.x1
   ->  Sort
         Output: (x.edges[1]), NULL::edge, (x.edges[2].id)
         Sort Key: (x.edges[2].id)
         ->  Nested Loop
               Output: x.edges[1], NULL::edge, x.edges[2].id
               Inner Unique: true
               ->  Nested Loop
                     Output: x.edges, x."end"
                     ->  Seq Scan on t.person a
                           Output: a.id, a.properties
                           Filter: (a.properties.'id' = '1'::jsonb)
                     ->  Subquery Scan on x
                           Output: x.start, x."end", x.ids, x.edges
                           ->  Graph VLE on knows [1..2]
                                 Direction: outgoing (->)
                                 Edge Labels:
                                   knows
                                   friendships
                                   familyship
                                 ->  Result
                                       Output: a.id, a.id, '{}'::graphid[], '[]'::edge[]
               ->  Memoize
                     Output: b.id
                     Cache Key: x."end"
                     Cache Mode: logical
                     ->  Index Only Scan using person_pkey on t.person b
                           Output: b.id
                           Index Cond: (b.id = x."end")
(30 rows)

