         Hash Cond: (kin.start = s.id)
         ->  Append
               ->  Seq Scan on kin
               ->  Seq Scan on kid kin_1
               ->  Seq Scan on kin kin_2
               ->  Seq Scan on kid kin_3
         ->  Hash
               ->  Seq Scan on nd s
   ->  Hash
         ->  Hash Join
               Hash Cond: (kid."end" = x.id)
               ->  Hash Join
                     Hash Cond: (kid.start = m.id)
                     ->  Append
                           ->  Seq Scan on kid
                           ->  Seq Scan on kid kid_1
                     ->  Hash
                           ->  Seq Scan on nd m
               ->  Hash
                     ->  Seq Scan on nd x
