-- hybrid: gate with EXISTS, gather with COLLECT
MATCH (person:Person)
WHERE EXISTS { MATCH (person)-[:HAS_DOG]->(:Dog) }
RETURN person.name AS name,
       COLLECT { MATCH (person)-[:HAS_DOG]->(d:Dog) RETURN d.name ORDER BY d.name } AS names
ORDER BY name;
