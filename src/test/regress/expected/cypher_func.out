--
-- Testing start_id(), end_id() functions for edges
--
-- Creating sample graph
CREATE GRAPH edge_test_graph;
SET graph_path = edge_test_graph;
CREATE (keanu:Person {name: 'Keanu Reeves', age: 58}),
  (speed:Movie {title: 'Speed'}),
  (keanu)-[:ACTED_IN]->(speed);
-- Testing the start_id(), end_id() function
MATCH (n1)-[e1]->(n2) return id(n1),id(e1),id(n2),start_id(e1),end_id(e1);
 id  | id  | id  | start_id | end_id 
-----+-----+-----+----------+--------
 3.1 | 5.1 | 4.1 | 3.1      | 4.1
(1 row)

-- Clean up
DROP GRAPH edge_test_graph CASCADE;
NOTICE:  drop cascades to 6 other objects
DETAIL:  drop cascades to sequence edge_test_graph.ag_label_seq
drop cascades to vlabel ag_vertex
drop cascades to elabel ag_edge
drop cascades to vlabel person
drop cascades to vlabel movie
drop cascades to elabel acted_in
--
-- Testing the cardinality() function
--
-- Creating sample graph
CREATE GRAPH cardinality_graph;
SET graph_path = cardinality_graph;
CREATE (:P {name: 'a', age: 1})-[:R {w: 1}]->(:P {name: 'b'});
-- a list's cardinality is its element count
RETURN cardinality(['a','b']) AS r;
 r 
---
 2
(1 row)

RETURN cardinality([]) AS r;
 r 
---
 0
(1 row)

-- a map's cardinality is its entry count
RETURN cardinality({a: 1, b: 2, c: 3}) AS r;
 r 
---
 3
(1 row)

-- and both agree with stored data
MATCH (n:P {name: 'a'}) RETURN cardinality(keys(n)) AS r;
 r 
---
 2
(1 row)

MATCH (n:P {name: 'a'}) RETURN cardinality(properties(n)) AS r;
 r 
---
 2
(1 row)

-- a path's cardinality counts its vertices and edges both
MATCH p = (:P {name: 'a'})-[:R]->(:P) RETURN cardinality(p) AS r;
 r 
---
 3
(1 row)

-- null in, null out
RETURN cardinality(null) IS NULL AS r;
 r 
---
 t
(1 row)

-- a scalar has no cardinality
RETURN cardinality('abc') AS r;
ERROR:  cardinality(): list or map is expected but "abc"
RETURN cardinality(1) AS r;
ERROR:  cardinality(): list or map is expected but 1
-- the relational form is untouched
SELECT cardinality(ARRAY[1,2,3]) AS r;
 r 
---
 3
(1 row)

-- Clean up
DROP GRAPH cardinality_graph CASCADE;
NOTICE:  drop cascades to 5 other objects
DETAIL:  drop cascades to sequence cardinality_graph.ag_label_seq
drop cascades to vlabel ag_vertex
drop cascades to elabel ag_edge
drop cascades to vlabel p
drop cascades to elabel r
--
-- Testing collect() over graph elements
--
-- Creating sample graph
CREATE GRAPH collect_graph;
SET graph_path = collect_graph;
CREATE (:P {name: 'alice', age: 30})-[:R {since: 2020}]->(:P {name: 'bob', age: 25});
-- a collected node is still a node: the list renders its elements, an
-- element taken back out answers its properties, its label and its id
MATCH (n:P) RETURN collect(n);
                                collect                                
-----------------------------------------------------------------------
 [p[3.1]{"age": 30, "name": "alice"},p[3.2]{"age": 25, "name": "bob"}]
(1 row)

MATCH (n:P) WITH collect(n) AS ns RETURN ns[0].name;
  name   
---------
 "alice"
(1 row)

MATCH (n:P) WITH collect(n) AS ns, count(*) AS c RETURN ns[c-1].name;
 name  
-------
 "bob"
(1 row)

MATCH (n:P) WITH collect(n) AS ns UNWIND ns AS x RETURN x.name ORDER BY x.name;
  name   
---------
 "alice"
 "bob"
(2 rows)

MATCH (n:P) WITH collect(n) AS ns RETURN label(ns[0]), id(ns[0]) IS NULL;
 label | ?column? 
-------+----------
 "p"   | f
(1 row)

-- relationships and paths the same way
MATCH ()-[r:R]->() WITH collect(r) AS rs RETURN rs[0].since;
 since 
-------
 2020
(1 row)

MATCH p = (:P)-[:R]->(:P) WITH collect(p) AS ps
	RETURN length(ps[0]), [x IN nodes(ps[0]) | x.name];
 length |     ?column?     
--------+------------------
 1      | ["alice", "bob"]
(1 row)

-- list functions and comprehensions read the collected list
MATCH (n:P) WITH collect(n) AS ns
	RETURN size(ns), [x IN ns WHERE x.age > 26 | x.name];
 length | ?column?  
--------+-----------
 2      | ["alice"]
(1 row)

-- collecting nothing is an empty list, and null elements are left out
MATCH (n:nonexistent) RETURN collect(n), size(collect(n));
 collect | length 
---------+--------
 []      | 0
(1 row)

MATCH (n:P) OPTIONAL MATCH (n)-[:R]->(m:P {name: 'nomatch'})
	RETURN size(collect(m));
 length 
--------
 0
(1 row)

-- DISTINCT de-duplicates by the element
MATCH (n:P {name: 'alice'}), (m:P)
	WITH collect(n) AS all_ns, collect(DISTINCT n) AS ns
	RETURN size(all_ns), size(ns);
 length | length 
--------+--------
 2      | 1
(1 row)

-- a property collect stays a jsonb list
MATCH (n:P) RETURN collect(n.name) ORDER BY 1;
     collect      
------------------
 ["alice", "bob"]
(1 row)

-- a collected list stored into a property map is boxed to jsonb, since a
-- property holds values, not elements
MATCH (n:P {name: 'alice'}) WITH collect(n) AS ns
	MATCH (m:P {name: 'bob'}) SET m.keep = ns;
ERROR:  property cannot hold vertex[]
LINE 2:  MATCH (m:P {name: 'bob'}) SET m.keep = ns;
                                                ^
MATCH (m:P {name: 'bob'}) RETURN m.keep;
 keep 
------
 
(1 row)

-- Clean up
DROP GRAPH collect_graph CASCADE;
NOTICE:  drop cascades to 5 other objects
DETAIL:  drop cascades to sequence collect_graph.ag_label_seq
drop cascades to vlabel ag_vertex
drop cascades to elabel ag_edge
drop cascades to vlabel p
drop cascades to elabel r
--
-- Testing head(), last() and tail() over a list
--
-- a list of nothing has no first and no last element, and everything after
-- its first element is a list of nothing.  A constant is folded at plan time,
-- so both spellings are exercised.
SELECT head('{}'::text[]) IS NULL, last('{}'::text[]) IS NULL, tail('{}'::text[]);
 ?column? | ?column? | tail 
----------+----------+------
 t        | t        | {}
(1 row)

SELECT head(a) IS NULL, last(a) IS NULL, tail(a)
	FROM (VALUES('{}'::text[])) s(a);
 ?column? | ?column? | tail 
----------+----------+------
 t        | t        | {}
(1 row)

SELECT head(a) IS NULL, last(a) IS NULL, tail(a)
	FROM (VALUES('{}'::int[])) s(a);
 ?column? | ?column? | tail 
----------+----------+------
 t        | t        | {}
(1 row)

-- an element that is null answers as null, rather than as a value
SELECT head(a) IS NULL FROM (VALUES(ARRAY[NULL::text,'a'])) s(a);
 ?column? 
----------
 t
(1 row)

SELECT last(a) IS NULL FROM (VALUES(ARRAY['a',NULL::text])) s(a);
 ?column? 
----------
 t
(1 row)

SELECT head(a) IS NULL FROM (VALUES(ARRAY[NULL::int,1])) s(a);
 ?column? 
----------
 t
(1 row)

-- a list that arrives as a concatenation carries its elements in another
-- form, and is read the same way
CREATE TABLE list_src (t text[], i int[]);
INSERT INTO list_src VALUES (ARRAY['a','b'], ARRAY[1,2]);
SELECT head(t || 'c'::text), last(t || 'c'::text), tail(t || 'c'::text)
	FROM list_src;
 head | last | tail  
------+------+-------
 a    | c    | {b,c}
(1 row)

SELECT head(i || 3), last(i || 3), tail(i || 3) FROM list_src;
 head | last | tail  
------+------+-------
    1 |    3 | {2,3}
(1 row)

SELECT head('x'::text || t), last('x'::text || t) FROM list_src;
 head | last 
------+------
 x    | b
(1 row)

-- a list is read from its own lower bound, which is not always one
SELECT head(a), last(a), tail(a)
	FROM (VALUES('[0:2]={10,20,30}'::int[])) s(a);
 head | last |  tail   
------+------+---------
   10 |   30 | {20,30}
(1 row)

SELECT head(a), last(a), tail(a)
	FROM (VALUES('[5:7]={10,20,30}'::int[])) s(a);
 head | last |  tail   
------+------+---------
   10 |   30 | {20,30}
(1 row)

-- and what is taken from a list is itself read from one
SELECT array_lower(tail(a), 1)
	FROM (VALUES('[5:7]={10,20,30}'::int[])) s(a);
 array_lower 
-------------
           1
(1 row)

-- an array that is not a list is refused rather than answered wrongly
SELECT head(a) FROM (VALUES(ARRAY[[1,2],[3,4]])) s(a);
ERROR:  head(): argument must be empty or one-dimensional array
SELECT last(a) FROM (VALUES(ARRAY[[1,2],[3,4]])) s(a);
ERROR:  last(): argument must be empty or one-dimensional array
SELECT tail(a) FROM (VALUES(ARRAY[[1,2],[3,4]])) s(a);
ERROR:  tail(): argument must be empty or one-dimensional array
-- an element type that has no ordering of its own is still readable
SELECT head(a) FROM (VALUES(ARRAY['{"a": 1}'::json])) s(a);
   head   
----------
 {"a": 1}
(1 row)

SELECT last(a) FROM (VALUES(ARRAY['(1,2)'::point])) s(a);
 last  
-------
 (1,2)
(1 row)

-- nulls are kept where they are
SELECT tail(a) FROM (VALUES(ARRAY['hi',null,null,'bye'])) s(a);
      tail       
-----------------
 {NULL,NULL,bye}
(1 row)

DROP TABLE list_src;
-- over the lists a graph query produces
CREATE GRAPH list_graph;
SET graph_path = list_graph;
CREATE (:P {name: 'alice'})-[:R {since: 2020}]->(:P {name: 'bob'});
MATCH p = (:P)-[:R]->(:P) RETURN head(vertices(p)), last(vertices(p));
          head           |         last          
-------------------------+-----------------------
 p[3.1]{"name": "alice"} | p[3.2]{"name": "bob"}
(1 row)

MATCH p = (:P)-[:R]->(:P) RETURN head(nodes(p)), last(nodes(p));
          head           |         last          
-------------------------+-----------------------
 p[3.1]{"name": "alice"} | p[3.2]{"name": "bob"}
(1 row)

MATCH p = (:P)-[:R]->(:P) RETURN head(edges(p)), head(relationships(p));
              head              |              head              
--------------------------------+--------------------------------
 r[4.1][3.1,3.2]{"since": 2020} | r[4.1][3.1,3.2]{"since": 2020}
(1 row)

MATCH p = (:P)-[:R]->(:P) RETURN tail(vertices(p)), size(tail(vertices(p)));
          tail           | length 
-------------------------+--------
 [p[3.2]{"name": "bob"}] | 1
(1 row)

MATCH (n:P) WITH collect(n) AS ns
	RETURN head(ns), last(ns), size(tail(ns)), tail(ns)[0];
          head           |         last          | length |         tail          
-------------------------+-----------------------+--------+-----------------------
 p[3.1]{"name": "alice"} | p[3.2]{"name": "bob"} | 1      | p[3.2]{"name": "bob"}
(1 row)

MATCH ()-[r:R]->() WITH collect(r) AS rs RETURN head(rs), last(rs);
              head              |              last              
--------------------------------+--------------------------------
 r[4.1][3.1,3.2]{"since": 2020} | r[4.1][3.1,3.2]{"since": 2020}
(1 row)

MATCH p = (:P)-[:R]->(:P) WITH collect(p) AS ps
	RETURN size(head(ps)), size(tail(ps));
 length | length 
--------+--------
 1      | 0
(1 row)

-- a list of nothing, from a pattern that matches nothing
MATCH (n:nonexistent) WITH collect(n) AS ns
	RETURN head(ns) IS NULL, last(ns) IS NULL, size(tail(ns));
 ?column? | ?column? | length 
----------+----------+--------
 t        | t        | 0
(1 row)

-- the jsonb forms are unchanged
RETURN head(['a','b']), last(['a','b']), tail(['a','b']);
 head | last | tail  
------+------+-------
 "a"  | "b"  | ["b"]
(1 row)

RETURN head([]) IS NULL, last([]) IS NULL, tail([]);
 ?column? | ?column? | tail 
----------+----------+------
 t        | t        | []
(1 row)

RETURN head([null,'a']), tail([1]);
 head | tail 
------+------
 null | []
(1 row)

--
-- AGV2-552
--
-- Every width is read with its own accessor, so a value comes back as itself
-- rather than as whatever another width makes of its bytes.  An element that
-- names no such value comes back null, and the list keeps its length.
SELECT toStringList(ARRAY[5000000000::int8]);
 tostringlist 
--------------
 {5000000000}
(1 row)

SELECT toIntegerList(ARRAY[5000000000::int8]);
 tointegerlist 
---------------
 {5000000000}
(1 row)

SELECT toStringList(ARRAY[1.5::float4]);
 tostringlist 
--------------
 {1.5}
(1 row)

SELECT toFloatList(ARRAY[1.5::float4]);
 tofloatlist 
-------------
 {1.5}
(1 row)

SELECT toStringList(ARRAY[42]), toFloatList(ARRAY[1.5::float8]);
 tostringlist | tofloatlist 
--------------+-------------
 {42}         | {1.5}
(1 row)

-- a string naming a number reads as that number, at its own width
SELECT toIntegerList(ARRAY['5000000000']);
 tointegerlist 
---------------
 {5000000000}
(1 row)

SELECT toFloatList(ARRAY['3.14159265358979']);
    tofloatlist     
--------------------
 {3.14159265358979}
(1 row)

-- a string naming a number with a fraction reads as its whole part
SELECT toIntegerList(ARRAY['1.9', '-1.9']);
 tointegerlist 
---------------
 {1,-1}
(1 row)

-- what names no number is null, not zero
SELECT toIntegerList(ARRAY['--5', '1e400', '', 'abc']);
     tointegerlist     
-----------------------
 {NULL,NULL,NULL,NULL}
(1 row)

SELECT toIntegerList(ARRAY[now()]);
 tointegerlist 
---------------
 {NULL}
(1 row)

SELECT toFloatList(ARRAY['abc']);
 tofloatlist 
-------------
 {NULL}
(1 row)

-- the result is a list of what was asked for, whatever was given
SELECT pg_typeof(toIntegerList(ARRAY['1'])), pg_typeof(toFloatList(ARRAY[1::int2]));
 pg_typeof |     pg_typeof      
-----------+--------------------
 bigint[]  | double precision[]
(1 row)

SELECT pg_typeof(toStringList(ARRAY[1,2])), (toStringList(ARRAY[1,2]))[1] || 'suffix';
 pg_typeof | ?column? 
-----------+----------
 text[]    | 1suffix
(1 row)

-- a list of one element is a list of one element
RETURN toIntegerList([7]), toStringList([7]), toFloatList([1.5]);
 tointegerlist | tostringlist | tofloatlist 
---------------+--------------+-------------
 [7]           | ["7"]        | [1.5]
(1 row)

-- and a float keeps the precision it was given
RETURN toFloatList([1.23456789012]);
   tofloatlist   
-----------------
 [1.23456789012]
(1 row)

-- an element longer than any buffer is still just an element
RETURN toIntegerList([
	'11111111111111111111111111111111111111111111111111111111111111111111', 1]);
 tointegerlist 
---------------
 [null, 1]
(1 row)

DROP GRAPH list_graph CASCADE;
NOTICE:  drop cascades to 5 other objects
DETAIL:  drop cascades to sequence list_graph.ag_label_seq
drop cascades to vlabel ag_vertex
drop cascades to elabel ag_edge
drop cascades to vlabel p
drop cascades to elabel r
