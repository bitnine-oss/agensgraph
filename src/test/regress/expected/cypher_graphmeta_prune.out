               ->  Bitmap Index Scan on city_pkey
                     Index Cond: (id = ANY ('{3.1,4.1}'::graphid[]))
         ->  Bitmap Heap Scan on employee u_4
               Recheck Cond: ((id = '3.1'::graphid) OR (id = '4.1'::graphid))
               ->  Bitmap Index Scan on employee_pkey
                     Index Cond: (id = ANY ('{3.1,4.1}'::graphid[]))
         ->  Bitmap Heap Scan on manager u_5
               Recheck Cond: ((id = '3.1'::graphid) OR (id = '4.1'::graphid))
               ->  Bitmap Index Scan on manager_pkey
                     Index Cond: (id = ANY ('{3.1,4.1}'::graphid[]))
(18 rows)

MATCH (u) WHERE id(u) = '3.1'::graphid OR id(u) = '4.1'::graphid RETURN label(u) AS l, id(u) AS id ORDER BY id;
