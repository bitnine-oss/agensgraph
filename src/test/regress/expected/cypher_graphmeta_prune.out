              QUERY PLAN              
--------------------------------------
 Hash Join
   Hash Cond: (e1."end" = c.id)
   ->  Append
         ->  Seq Scan on e1
         ->  Seq Scan on e1 e1_1
   ->  Hash
         ->  Append
               ->  Seq Scan on n1 c_1
               ->  Seq Scan on n2 c_2
(9 rows)

MATCH (a)-[b:e1]-(c) RETURN label(a) AS a, label(c) AS c ORDER BY a, c;
  a   |  c   
------+------
 "n1" | "n2"
 "n2" | "n1"
(2 rows)

