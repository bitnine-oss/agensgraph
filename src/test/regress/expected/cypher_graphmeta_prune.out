--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Bitmap Heap Scan on knows "<0000000107>"
         Recheck Cond: ((("end" = '4.1'::graphid) AND (start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid)) OR (("end" = '4.1'::graphid) AND (start >= '5.0'::graphid) AND (start <= '5.281474976710655'::graphid)))
         ->  BitmapOr
               ->  Bitmap Index Scan on knows_end_idx
                     Index Cond: (("end" = '4.1'::graphid) AND (start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
               ->  Bitmap Index Scan on knows_end_idx
                     Index Cond: (("end" = '4.1'::graphid) AND (start >= '5.0'::graphid) AND (start <= '5.281474976710655'::graphid))
   ->  Index Scan using city_pkey on city b
         Index Cond: (id = '4.1'::graphid)
(10 rows)

MATCH (a:person)-[:knows]->(b) WHERE id(b) = '4.1'::graphid RETURN label(b) AS l;
