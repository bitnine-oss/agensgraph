         ->  Append
               ->  Seq Scan on ag_edge
               ->  Seq Scan on e1 ag_edge_1
               ->  Seq Scan on e2 ag_edge_2
               ->  Seq Scan on e3 ag_edge_3
               ->  Seq Scan on e4 ag_edge_4
               ->  Seq Scan on ex ag_edge_5
               ->  Seq Scan on ey ag_edge_6
               ->  Seq Scan on ag_edge ag_edge_7
               ->  Seq Scan on e1 ag_edge_8
               ->  Seq Scan on e2 ag_edge_9
               ->  Seq Scan on e3 ag_edge_10
               ->  Seq Scan on e4 ag_edge_11
               ->  Seq Scan on ex ag_edge_12
               ->  Seq Scan on ey ag_edge_13
         ->  Hash
               ->  Seq Scan on n1 a
   ->  Hash
         ->  Seq Scan on n2 c
