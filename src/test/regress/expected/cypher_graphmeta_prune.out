-- ============================================================
-- self-loops and cycles: the solver must terminate and prune correctly when a
-- label reaches itself or the pattern forms a cycle.
-- ============================================================
CREATE GRAPH gmp6;
SET graph_path = gmp6;
CREATE VLABEL sl;
CREATE VLABEL t1; CREATE VLABEL t2; CREATE VLABEL t3;
CREATE ELABEL loop;
CREATE ELABEL te;
SET auto_gather_graphmeta = true;
-- self-loop sl -loop-> sl
CREATE (:sl);
MATCH (s:sl) CREATE (s)-[:loop]->(s);
-- triangle t1 -te-> t2 -te-> t3 -te-> t1
CREATE (:t1)-[:te]->(:t2)-[:te]->(:t3);
MATCH (a:t3), (b:t1) CREATE (a)-[:te]->(b);
SELECT * FROM ag_graphmeta_view ORDER BY start, edge, "end";
 graphname | start | edge | end | edgecount 
-----------+-------+------+-----+-----------
 gmp6      | sl    | loop | sl  |         1
 gmp6      | t1    | te   | t2  |         1
 gmp6      | t2    | te   | t3  |         1
 gmp6      | t3    | te   | t1  |         1
(4 rows)

-- self-loop: far node is the same label
EXPLAIN (costs off) MATCH (a:sl)-[b]->(c) RETURN c;
                                            QUERY PLAN                                             
---------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Bitmap Heap Scan on loop b
         Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
         ->  Bitmap Index Scan on loop_start_idx
               Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
   ->  Index Scan using sl_pkey on sl c
         Index Cond: (id = b."end")
(7 rows)

MATCH (a:sl)-[b]->(c) RETURN label(b) AS b, label(c) AS c ORDER BY b, c;
   b    |  c   
--------+------
 "loop" | "sl"
(1 row)

-- cycle: three hops around the triangle land back on t1
EXPLAIN (costs off) MATCH (a:t1)-[b]->(c)-[d]->(e)-[f]->(g) RETURN g;
                                                     QUERY PLAN                                                      
---------------------------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Nested Loop
         Join Filter: (b.id <> f.id)
         ->  Hash Join
               Hash Cond: (d.start = b."end")
               Join Filter: (b.id <> d.id)
               ->  Seq Scan on te d
               ->  Hash
                     ->  Bitmap Heap Scan on te b
                           Recheck Cond: ((start >= '4.0'::graphid) AND (start <= '4.281474976710655'::graphid))
                           ->  Bitmap Index Scan on te_start_idx
                                 Index Cond: ((start >= '4.0'::graphid) AND (start <= '4.281474976710655'::graphid))
         ->  Index Scan using te_start_idx on te f
               Index Cond: (start = d."end")
               Filter: (d.id <> id)
   ->  Index Scan using t1_pkey on t1 g
         Index Cond: (id = f."end")
(17 rows)

MATCH (a:t1)-[b]->(c)-[d]->(e)-[f]->(g)
  RETURN label(c) AS c, label(e) AS e, label(g) AS g ORDER BY c, e, g;
  c   |  e   |  g   
------+------+------
 "t2" | "t3" | "t1"
(1 row)

-- equivalence for the cyclic shapes
SET auto_gather_graphmeta = false;
MATCH (a:sl)-[b]->(c) RETURN label(b) AS b, label(c) AS c ORDER BY b, c;
   b    |  c   
--------+------
 "loop" | "sl"
(1 row)

MATCH (a:t1)-[b]->(c)-[d]->(e)-[f]->(g) RETURN label(c) AS c, label(e) AS e, label(g) AS g ORDER BY c, e, g;
  c   |  e   |  g   
------+------+------
 "t2" | "t3" | "t1"
(1 row)

SET auto_gather_graphmeta = true;
NOTICE:  regathering graphmeta...
DROP GRAPH gmp6 CASCADE;
NOTICE:  drop cascades to 9 other objects
DETAIL:  drop cascades to sequence gmp6.ag_label_seq
drop cascades to vlabel ag_vertex
drop cascades to elabel ag_edge
drop cascades to vlabel sl
drop cascades to vlabel t1
drop cascades to vlabel t2
drop cascades to vlabel t3
drop cascades to elabel loop
drop cascades to elabel te
-- ============================================================
-- prepared statements adapt to connectivity changes: a cached (generic) pruned
-- plan must be re-planned when new labels/edges extend what the pattern reaches,
-- so it never keeps scanning a stale, too-narrow label set (which would drop the
-- newly-connected rows).
-- ============================================================
CREATE GRAPH gmp7;
SET graph_path = gmp7;
CREATE VLABEL n1; CREATE VLABEL n2;
CREATE ELABEL e1;
SET auto_gather_graphmeta = true;
CREATE (:n1)-[:e1]->(:n2);
SELECT * FROM ag_graphmeta_view ORDER BY start, edge, "end";
 graphname | start | edge | end | edgecount 
-----------+-------+------+-----+-----------
 gmp7      | n1    | e1   | n2  |         1
(1 row)

-- force the generic (cached) plan so we actually exercise plan-cache reuse
SET plan_cache_mode = force_generic_plan;
PREPARE pp AS MATCH (a:n1)-[b]->(c) RETURN label(b) AS b, label(c) AS c ORDER BY b, c;
-- initial cached plan: b scans only {e1}, c only {n2}
EXPLAIN (costs off) EXECUTE pp;
                                                           QUERY PLAN                                                           
--------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (label(ROW(b.id, b.start, b."end", b.properties, b.ctid)::edge)), (label(ROW(c.id, c.properties, c.ctid)::vertex))
   ->  Nested Loop
         ->  Bitmap Heap Scan on e1 b
               Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
               ->  Bitmap Index Scan on e1_start_idx
                     Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
         ->  Index Scan using n2_pkey on n2 c
               Index Cond: (id = b."end")
(9 rows)

EXECUTE pp;
  b   |  c   
------+------
 "e1" | "n2"
(1 row)

-- modify the graph: a NEW edge label + vertex label that n1 now also reaches
CREATE VLABEL n3;
CREATE ELABEL e2;
CREATE (:n1)-[:e2]->(:n3);
SELECT * FROM ag_graphmeta_view ORDER BY start, edge, "end";
 graphname | start | edge | end | edgecount 
-----------+-------+------+-----+-----------
 gmp7      | n1    | e1   | n2  |         1
 gmp7      | n1    | e2   | n3  |         1
(2 rows)

-- the cached plan must be re-planned: b now scans {e1,e2}, c now {n2,n3}
EXPLAIN (costs off) EXECUTE pp;
                                                           QUERY PLAN                                                           
--------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (label(ROW(b.id, b.start, b."end", b.properties, b.ctid)::edge)), (label(ROW(c.id, c.properties, c.ctid)::vertex))
   ->  Hash Join
         Hash Cond: (c.id = b."end")
         ->  Append
               ->  Seq Scan on n2 c_1
               ->  Seq Scan on n3 c_2
         ->  Hash
               ->  Append
                     ->  Bitmap Heap Scan on e1 b_1
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e1_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                     ->  Bitmap Heap Scan on e2 b_2
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e2_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
(17 rows)

EXECUTE pp;
  b   |  c   
------+------
 "e1" | "n2"
 "e2" | "n3"
(2 rows)

-- extend once more with another new endpoint label reached from n1
CREATE VLABEL n4;
CREATE (:n1)-[:e2]->(:n4);
SELECT * FROM ag_graphmeta_view ORDER BY start, edge, "end";
 graphname | start | edge | end | edgecount 
-----------+-------+------+-----+-----------
 gmp7      | n1    | e1   | n2  |         1
 gmp7      | n1    | e2   | n3  |         1
 gmp7      | n1    | e2   | n4  |         1
(3 rows)

EXPLAIN (costs off) EXECUTE pp;
                                                           QUERY PLAN                                                           
--------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (label(ROW(b.id, b.start, b."end", b.properties, b.ctid)::edge)), (label(ROW(c.id, c.properties, c.ctid)::vertex))
   ->  Hash Join
         Hash Cond: (c.id = b."end")
         ->  Append
               ->  Seq Scan on n2 c_1
               ->  Seq Scan on n3 c_2
               ->  Seq Scan on n4 c_3
         ->  Hash
               ->  Append
                     ->  Bitmap Heap Scan on e1 b_1
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e1_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                     ->  Bitmap Heap Scan on e2 b_2
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e2_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
(18 rows)

EXECUTE pp;
  b   |  c   
------+------
 "e1" | "n2"
 "e2" | "n3"
 "e2" | "n4"
(3 rows)

-- an UNRELATED new component must NOT widen n1's pruned set (still {e1,e2}/{n2,n3,n4})
CREATE VLABEL u1; CREATE VLABEL u2; CREATE ELABEL eu;
CREATE (:u1)-[:eu]->(:u2);
EXPLAIN (costs off) EXECUTE pp;
                                                           QUERY PLAN                                                           
--------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: (label(ROW(b.id, b.start, b."end", b.properties, b.ctid)::edge)), (label(ROW(c.id, c.properties, c.ctid)::vertex))
   ->  Hash Join
         Hash Cond: (c.id = b."end")
         ->  Append
               ->  Seq Scan on n2 c_1
               ->  Seq Scan on n3 c_2
               ->  Seq Scan on n4 c_3
         ->  Hash
               ->  Append
                     ->  Bitmap Heap Scan on e1 b_1
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e1_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                     ->  Bitmap Heap Scan on e2 b_2
                           Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
                           ->  Bitmap Index Scan on e2_start_idx
                                 Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
(18 rows)

EXECUTE pp;
  b   |  c   
------+------
 "e1" | "n2"
 "e2" | "n3"
 "e2" | "n4"
(3 rows)

-- ground truth: the prepared (pruned) result equals the unpruned scan
SET auto_gather_graphmeta = false;
MATCH (a:n1)-[b]->(c) RETURN label(b) AS b, label(c) AS c ORDER BY b, c;
  b   |  c   
------+------
 "e1" | "n2"
 "e2" | "n3"
 "e2" | "n4"
(3 rows)

SET auto_gather_graphmeta = true;
NOTICE:  regathering graphmeta...
DEALLOCATE pp;
SET plan_cache_mode = auto;
DROP GRAPH gmp7 CASCADE;
