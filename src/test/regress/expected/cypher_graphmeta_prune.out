-- ---------- LEFT direction (edge maps to graphmeta end/start reversed) ----------
-- (a)<-[b]-(c:n1): c=n1 is the start side, so a prunes to {n2}
EXPLAIN (costs off) MATCH (a)<-[b]-(c:n1) RETURN a;
                                            QUERY PLAN                                             
---------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Bitmap Heap Scan on e1 b
         Recheck Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
         ->  Bitmap Index Scan on e1_start_idx
               Index Cond: ((start >= '3.0'::graphid) AND (start <= '3.281474976710655'::graphid))
   ->  Index Scan using n2_pkey on n2 a
         Index Cond: (id = b."end")
(7 rows)

