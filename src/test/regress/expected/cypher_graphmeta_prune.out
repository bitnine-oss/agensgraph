 Graph Delete
   ->  Nested Loop CypherDelete Join
         ->  Seq Scan on v x
         ->  Aggregate
               ->  Nested Loop
                     ->  Function Scan on unnest v_1
                     ->  Bitmap Heap Scan on loop e_1
                           Recheck Cond: ((start = v_1.id) OR ("end" = v_1.id))
                           ->  BitmapOr
                                 ->  Bitmap Index Scan on loop_start_idx
                                       Index Cond: (start = v_1.id)
                                 ->  Bitmap Index Scan on loop_end_idx
                                       Index Cond: ("end" = v_1.id)
