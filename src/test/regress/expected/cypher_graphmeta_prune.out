-------------------------------------------------------------------------
 Hash Join
   Hash Cond: (f."end" = g.id)
   ->  Hash Join
         Hash Cond: (b.start = a.id)
         ->  Hash Join
               Hash Cond: (f.start = e.id)
               Join Filter: ((b.id <> f.id) AND (d.id <> f.id))
               ->  Seq Scan on e4 f
               ->  Hash
                     ->  Hash Join
                           Hash Cond: (d."end" = e.id)
                           ->  Hash Join
                                 Hash Cond: (d.start = c.id)
                                 Join Filter: (b.id <> d.id)
                                 ->  Seq Scan on e3 d
                                 ->  Hash
                                       ->  Hash Join
                                             Hash Cond: (b."end" = c.id)
                                             ->  Seq Scan on e2 b
                                             ->  Hash
                                                   ->  Seq Scan on n3 c
                           ->  Hash
                                 ->  Seq Scan on n4 e
         ->  Hash
               ->  Seq Scan on n2 a
   ->  Hash
         ->  Seq Scan on n5 g
(27 rows)

MATCH (a)-[b]->(c)-[d]->(e)-[f:e4]->(g) RETURN label(a) AS a, label(g) AS g ORDER BY a, g;
