-- ---------- multiple comma-separated components: no false cross-component arc ----------
EXPLAIN (costs off) MATCH (a:n1)-[b]->(c), (x)-[y:eX]->(z) RETURN c, z;
                         QUERY PLAN                          
-------------------------------------------------------------
 Hash Join
   Hash Cond: (y."end" = z.id)
   ->  Hash Join
         Hash Cond: (y.start = x.id)
         ->  Nested Loop
               ->  Index Only Scan using ex_end_idx on ex y
               ->  Materialize
                     ->  Hash Join
                           Hash Cond: (b."end" = c.id)
                           ->  Hash Join
                                 Hash Cond: (b.start = a.id)
                                 ->  Seq Scan on e1 b
                                 ->  Hash
                                       ->  Seq Scan on n1 a
                           ->  Hash
                                 ->  Seq Scan on n2 c
         ->  Hash
               ->  Seq Scan on q1 x
   ->  Hash
         ->  Seq Scan on q2 z
(20 rows)

MATCH (a:n1)-[b]->(c), (x)-[y:eX]->(z)
  RETURN label(c) AS c, label(x) AS x, label(z) AS z ORDER BY c, x, z;
  c   |  x   |  z   
------+------+------
 "n2" | "q1" | "q2"
(1 row)

