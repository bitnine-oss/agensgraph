  a   |  b   
------+------
 "n2" | "e1"
(1 row)

-- (a:n2)<-[b]-(c): a=n2 is the end side, so c prunes to {n1}
EXPLAIN (costs off) MATCH (a:n2)<-[b]-(c) RETURN c;
                                            QUERY PLAN                                             
---------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Bitmap Heap Scan on e1 b
         Recheck Cond: (("end" >= '4.0'::graphid) AND ("end" <= '4.281474976710655'::graphid))
         ->  Bitmap Index Scan on e1_end_idx
               Index Cond: (("end" >= '4.0'::graphid) AND ("end" <= '4.281474976710655'::graphid))
   ->  Index Scan using n1_pkey on n1 c
         Index Cond: (id = b.start)
(7 rows)

MATCH (a:n2)<-[b]-(c) RETURN label(b) AS b, label(c) AS c ORDER BY b, c;
  b   |  c   
------+------
 "e1" | "n1"
(1 row)

-- ---------- undirected (node endpoints pruned; edge subquery not) ----------
