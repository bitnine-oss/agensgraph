(1 row)

-- Case 9: first edge labelled drives the chain transitively
EXPLAIN (costs off) MATCH (a)-[b:e1]->(c)-[d]->(e)-[f]->(g) RETURN g;
                     QUERY PLAN                     
----------------------------------------------------
 Merge Join
   Merge Cond: (d."end" = f.start)
   Join Filter: ((b.id <> f.id) AND (d.id <> f.id))
   ->  Nested Loop
         ->  Index Scan using e2_end_idx on e2 d
         ->  Index Scan using e1_end_idx on e1 b
               Index Cond: ("end" = d.start)
               Filter: (id <> d.id)
   ->  Sort
         Sort Key: f.start
         ->  Hash Join
               Hash Cond: (f."end" = g.id)
               ->  Seq Scan on e3 f
               ->  Hash
                     ->  Seq Scan on n4 g
(15 rows)

MATCH (a)-[b:e1]->(c)-[d]->(e)-[f]->(g) RETURN label(c) AS c, label(e) AS e, label(g) AS g ORDER BY c, e, g;
  c   |  e   |  g   
------+------+------
 "n2" | "n3" | "n4"
(1 row)

