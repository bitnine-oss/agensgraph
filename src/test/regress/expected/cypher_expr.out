-- a null list element is the Cypher null value: it is filtered by IS NOT NULL
-- and does not prematurely end the iteration (#780)
RETURN [x IN [1, null, 3] WHERE x IS NOT NULL];
 ?column? 
----------
 [1, 3]
(1 row)

