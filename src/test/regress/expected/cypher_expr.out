                                          ^
MATCH (n:aggnum) RETURN count(DISTINCT ALL n.v);
ERROR:  syntax error at or near "n"
LINE 1: MATCH (n:aggnum) RETURN count(DISTINCT ALL n.v);
                                                   ^
MATCH (n:aggnum) RETURN count(ALL *);
ERROR:  syntax error at or near "*"
LINE 1: MATCH (n:aggnum) RETURN count(ALL *);
