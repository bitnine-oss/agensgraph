SET enable_seqscan = on;
-- plan : seq scan
CREATE (:v3 {a: [1, 2, 3, 4, 5, 6, 7, 8, 9]});
EXPLAIN (costs off)
  MATCH (n1:v2), (n2:v3) WHERE n1.i IN n2.a
  RETURN n1;
                       QUERY PLAN                        
---------------------------------------------------------
 Nested Loop
   Join Filter: (n2.properties.'a' @> n1.properties.'i')
   ->  Seq Scan on v3 n2
   ->  Materialize
         ->  Seq Scan on v2 n1
