 3
(3 rows)

MATCH (n:aggnum) WITH ALL n.v AS v RETURN v ORDER BY v;
 v 
---
 1
 1
 2
 3
 3
(5 rows)

MATCH (n:aggnum) WITH n.v AS v RETURN ALL * ORDER BY v;
 v 
---
 1
 1
 2
 3
 3
(5 rows)

