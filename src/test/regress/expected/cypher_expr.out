EXPLAIN (costs off)
  MATCH (n1:v2 {name: 'seven'}), (n2:v2 {name: 'nine'})
  MATCH (n:v2) WHERE n.i IN [n1.i, 8, n2.i]
  RETURN n;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Nested Loop
   ->  Nested Loop
         ->  Seq Scan on v2 n1
               Disabled: true
               Filter: (properties.'name' = '"seven"'::jsonb)
         ->  Seq Scan on v2 n2
               Disabled: true
               Filter: (properties.'name' = '"nine"'::jsonb)
   ->  Index Scan using v2_i_idx on v2 n
         Index Cond: (properties.'i' = ANY (ARRAY[n1.properties.'i', '8'::jsonb, n2.properties.'i']))
