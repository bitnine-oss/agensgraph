MATCH (a:v1)
MERGE (b:v2 {no: a.no}) -- variable 'c' is invisible in this clause.
CREATE (c:v3 {no: a.no + 2});
MATCH (a:v2) RETURN label(a) as label, a.no AS no ORDER BY label, no;
 label | no 
-------+----
