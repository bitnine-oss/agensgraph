-- an eager (non-last) write, a constant-projection WITH, then another write:
-- when the first write's MATCH spans an edge pattern (a wide tuple), the eager
-- ModifyGraph becomes the inner side of a NestLoop and is wrapped in Materialize.
-- The Material must take its result descriptor from its child (whose real output
-- shape is materialized at run time) rather than from the ModifyGraph node's own
-- empty planner targetlist, else a zero-width result slot trips a slot-width
-- assertion.  Distinct labels keep the second write off the first write's rows.
CREATE VLABEL we_a;
CREATE VLABEL we_b;
CREATE VLABEL we_c;
CREATE ELABEL we_rel;
CREATE (:we_a)-[:we_rel]->(:we_b);
CREATE (:we_c);
MATCH (a:we_a)-[:we_rel]->(b:we_b) SET b.x = 1 WITH 1 AS one MATCH (c:we_c) SET c.y = 2;
MATCH (n:we_b) RETURN n.x AS we_b_x;
 we_b_x 
--------
 1
(1 row)

MATCH (n:we_c) RETURN n.y AS we_c_y;
 we_c_y 
--------
 2
(1 row)

-- A write clause followed (via WITH) by another clause that re-reads and writes
-- the same elements must observe the earlier writes regardless of the join the
-- optimizer chooses between them.  Otherwise the later clause's target scan can
-- be hash/merge-materialized before the earlier eager write runs, capture the
-- pre-write tuple versions, and fail with "attempted to update/delete invisible
-- tuple".  The earlier eager clause is now drained before the later read.
MATCH (n) DETACH DELETE n;
CREATE (a:v1 {k: 'a'}), (b:v1 {k: 'b'}),
       (d1:v2 {k: 'd1'}), (d2:v2 {k: 'd2'}), (sh:v2 {k: 'shared'}),
       (a)-[:e1]->(d1), (a)-[:e1]->(sh), (b)-[:e1]->(sh), (b)-[:e1]->(d2);
-- chained SET on shared/overlapping targets
MATCH (w:v1)-[:e1]->(d:v2) SET d.cc = 1
WITH w
MATCH (w)-[:e1]->(e:v2) SET e.dd = 1;
MATCH (n:v2) RETURN n.k AS k, n.cc AS cc, n.dd AS dd ORDER BY k;
    k     | cc | dd 
----------+----+----
 "d1"     | 1  | 1
 "d2"     | 1  | 1
 "shared" | 1  | 1
(3 rows)

-- same, with a hash join forced between the clauses
SET enable_nestloop = off;
SET enable_mergejoin = off;
MATCH (w:v1)-[:e1]->(d:v2) SET d.cc = 2
WITH w
MATCH (w)-[:e1]->(e:v2) SET e.dd = 2;
RESET enable_nestloop;
RESET enable_mergejoin;
MATCH (n:v2) RETURN n.k AS k, n.cc AS cc, n.dd AS dd ORDER BY k;
    k     | cc | dd 
----------+----+----
 "d1"     | 2  | 2
 "d2"     | 2  | 2
 "shared" | 2  | 2
(3 rows)

-- three chained write clauses
MATCH (w:v1)-[:e1]->(d:v2) SET d.p1 = 1
WITH w
MATCH (w)-[:e1]->(e:v2) SET e.p2 = 1
WITH e
MATCH (e) SET e.p3 = 1;
MATCH (n:v2) RETURN n.k AS k, n.p1 AS p1, n.p2 AS p2, n.p3 AS p3 ORDER BY k;
    k     | p1 | p2 | p3 
----------+----+----+----
 "d1"     | 1  | 1  | 1
 "d2"     | 1  | 1  | 1
 "shared" | 1  | 1  | 1
(3 rows)

-- SET then DELETE of the same edges (the "delete invisible tuple" variant)
MATCH (w:v1)-[:e1]->(d:v2) SET d.gone = 1
WITH d
MATCH (d)<-[r:e1]-() DELETE r;
MATCH (:v1)-[r:e1]->(:v2) RETURN count(r) AS remaining;
 remaining 
-----------
 0
(1 row)

MATCH (n:v1) DETACH DELETE n;
MATCH (n:v2) DETACH DELETE n;
-- A read clause that follows a write in the same statement must observe that
-- write.  The trailing MATCH is not a ModifyGraph node and reads the heap at
-- the ambient snapshot command id, so without advancing that command id past
-- the earlier clause's write window it would see the pre-write tuple.
MATCH (n) DETACH DELETE n;
CREATE (:v1 {name: 'a', age: 21});
-- SET then re-MATCH the same vertex: the trailing read must see age = 99
MATCH (p:v1 {name: 'a'}) SET p.age = 99
WITH p
MATCH (q:v1 {name: 'a'})
RETURN q.age AS should_be_99;
 should_be_99 
--------------
 99
(1 row)

-- same, with a hash join forced between the write and the trailing read
SET enable_nestloop = off;
SET enable_mergejoin = off;
MATCH (p:v1 {name: 'a'}) SET p.age = 100
WITH p
MATCH (q:v1 {name: 'a'})
RETURN q.age AS should_be_100;
 should_be_100 
---------------
 100
(1 row)

RESET enable_nestloop;
RESET enable_mergejoin;
MATCH (n:v1) DETACH DELETE n;
-- CREATE then re-MATCH in the same statement.  The CREATE auto-creates label
-- read_after_create, which does not exist when the trailing MATCH is parsed;
-- the MATCH must still recognise it as a label a preceding clause creates
-- (otherwise the scan folds to a constant-false One-Time Filter and the
-- side-effecting CREATE is discarded), and must then observe the new vertex.
CREATE (:read_after_create {v: 1})
WITH 1 AS dummy
MATCH (x:read_after_create)
RETURN count(x) AS should_be_1;
 should_be_1 
-------------
 1
(1 row)

-- the CREATE must have actually run
MATCH (x:read_after_create) RETURN count(x) AS created_total;
 created_total 
---------------
 1
(1 row)

MATCH (n:read_after_create) DETACH DELETE n;
-- a MATCH on a label that no preceding clause creates and that does not exist
-- must still match nothing (the One-Time Filter optimisation is preserved).
MATCH (x:never_created_label) RETURN count(x) AS should_be_0;
 should_be_0 
-------------
 0
(1 row)

