MATCH (a:v2) DETACH DELETE a;
-- MERGE - SET - MERGE
MATCH (:v1)
MERGE (a:v2 {no:1})
	ON MATCH SET a.cnt = a.cnt + 1
	ON CREATE SET a.cnt = 0
MERGE (b:v2 {cnt:2})
RETURN a=b;
