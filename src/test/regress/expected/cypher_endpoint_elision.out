SET enable_graph_endpoint_elision = false;
BEGIN;
  MATCH (a:person)-[b:knows]->() WITH DISTINCT a SET a.w = 1;
  MATCH (p:person) RETURN p.name AS p, p.w AS w ORDER BY p;
    p    | w 
---------+---
 "alice" | 1
 "bob"   | 1
