SET enable_graph_endpoint_elision = false;
BEGIN;
  MATCH (a:person)-[b:knows]->() MERGE (a)-[:tagged]->(:note {v:9});
  MATCH (a:person)-[t:tagged]->(n:note) RETURN a.name AS a, n.v AS v ORDER BY a, v;
    a    | v 
