                           Hash Cond: (b."end" = "<0000000088>".id)
                           ->  Seq Scan on lives_in b
                           ->  Hash
                                 ->  Seq Scan on city "<0000000088>"
         ->  Hash
               ->  Seq Scan on person a
   ->  Hash
         ->  Seq Scan on country e
