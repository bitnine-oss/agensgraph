SET enable_graph_endpoint_elision = true;
-- ============================================================
-- ELIDE: intermediate endpoint
-- ============================================================
-- The middle () is elided and the two edges are joined directly (e1.end = e2.start,
-- no middle vertex scan).
EXPLAIN (costs off) MATCH (a:person)-[]->()-[]->(c) RETURN a.name AS a, label(c) AS c;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Merge Join
   Merge Cond: ("<0000000010>"."end" = "<0000000012>".start)
   Join Filter: ("<0000000010>".id <> "<0000000012>".id)
   ->  Sort
         Sort Key: "<0000000010>"."end"
         ->  Hash Join
               Hash Cond: ("<0000000010>".start = a.id)
               ->  Append
                     ->  Seq Scan on knows "<0000000010>_1"
                     ->  Seq Scan on lives_in "<0000000010>_2"
               ->  Hash
                     ->  Seq Scan on person a
   ->  Sort
         Sort Key: "<0000000012>".start
         ->  Hash Join
               Hash Cond: ("<0000000012>"."end" = c.id)
               ->  Append
                     ->  Seq Scan on knows "<0000000012>_1"
                     ->  Seq Scan on lives_in "<0000000012>_2"
                     ->  Seq Scan on works_at "<0000000012>_3"
                     ->  Seq Scan on located_in "<0000000012>_4"
               ->  Hash
                     ->  Append
                           ->  Seq Scan on person c_1
                           ->  Seq Scan on city c_2
                           ->  Seq Scan on company c_3
                           ->  Seq Scan on country c_4
(27 rows)

MATCH (a:person)-[]->()-[]->(c) RETURN a.name AS a, label(c) AS c ORDER BY a, c;
    a    |     c     
---------+-----------
 "alice" | "company"
 "alice" | "country"
 "alice" | "person"
 "bob"   | "city"
 "bob"   | "person"
(5 rows)

SET enable_graph_endpoint_elision = false;
MATCH (a:person)-[]->()-[]->(c) RETURN a.name AS a, label(c) AS c ORDER BY a, c;
    a    |     c     
---------+-----------
 "alice" | "company"
 "alice" | "country"
 "alice" | "person"
 "bob"   | "city"
 "bob"   | "person"
(5 rows)

SET enable_graph_endpoint_elision = true;
-- labelled edges either side make the direct edge-to-edge join explicit in EXPLAIN.
EXPLAIN (costs off) MATCH (a:person)-[b:lives_in]->()-[d:located_in]->(e) RETURN a.name AS a, label(e) AS e;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Hash Join
   Hash Cond: (d."end" = e.id)
   ->  Merge Join
         Merge Cond: (d.start = b."end")
         Join Filter: (b.id <> d.id)
         ->  Index Scan using located_in_start_idx on located_in d
         ->  Sort
               Sort Key: b."end"
               ->  Hash Join
                     Hash Cond: (b.start = a.id)
                     ->  Seq Scan on lives_in b
                     ->  Hash
                           ->  Seq Scan on person a
   ->  Hash
         ->  Seq Scan on country e
(15 rows)

MATCH (a:person)-[b:lives_in]->()-[d:located_in]->(e) RETURN a.name AS a, label(e) AS e ORDER BY a, e;
    a    |     e     
---------+-----------
 "alice" | "country"
(1 row)

SET enable_graph_endpoint_elision = false;
MATCH (a:person)-[b:lives_in]->()-[d:located_in]->(e) RETURN a.name AS a, label(e) AS e ORDER BY a, e;
    a    |     e     
---------+-----------
 "alice" | "country"
(1 row)

SET enable_graph_endpoint_elision = true;
-- longer chain: two consecutive anonymous middles are both elided.
EXPLAIN (costs off) MATCH (a:person)-[]->()-[]->()-[]->(d) RETURN a.name AS a, label(d) AS d;
                                               QUERY PLAN                                               
--------------------------------------------------------------------------------------------------------
 Merge Join
   Merge Cond: ("<0000000026>".start = "<0000000024>"."end")
   Join Filter: (("<0000000022>".id <> "<0000000026>".id) AND ("<0000000024>".id <> "<0000000026>".id))
   ->  Sort
         Sort Key: "<0000000026>".start
         ->  Hash Join
               Hash Cond: ("<0000000026>"."end" = d.id)
               ->  Append
                     ->  Seq Scan on knows "<0000000026>_1"
                     ->  Seq Scan on lives_in "<0000000026>_2"
                     ->  Seq Scan on works_at "<0000000026>_3"
                     ->  Seq Scan on located_in "<0000000026>_4"
               ->  Hash
                     ->  Append
                           ->  Seq Scan on person d_1
                           ->  Seq Scan on city d_2
                           ->  Seq Scan on company d_3
                           ->  Seq Scan on country d_4
   ->  Sort
         Sort Key: "<0000000024>"."end"
         ->  Merge Join
               Merge Cond: ("<0000000024>".start = "<0000000022>"."end")
               Join Filter: ("<0000000022>".id <> "<0000000024>".id)
               ->  Merge Append
                     Sort Key: "<0000000024>".start, "<0000000024>"."end"
                     ->  Index Scan using knows_start_idx on knows "<0000000024>_1"
                     ->  Index Scan using lives_in_start_idx on lives_in "<0000000024>_2"
               ->  Sort
                     Sort Key: "<0000000022>"."end"
                     ->  Hash Join
                           Hash Cond: ("<0000000022>".start = a.id)
                           ->  Seq Scan on knows "<0000000022>"
                           ->  Hash
                                 ->  Seq Scan on person a
(34 rows)

MATCH (a:person)-[]->()-[]->()-[]->(d) RETURN a.name AS a, label(d) AS d ORDER BY a, d;
    a    |     d     
---------+-----------
 "alice" | "city"
 "bob"   | "company"
 "bob"   | "country"
(3 rows)

SET enable_graph_endpoint_elision = false;
MATCH (a:person)-[]->()-[]->()-[]->(d) RETURN a.name AS a, label(d) AS d ORDER BY a, d;
    a    |     d     
---------+-----------
 "alice" | "city"
 "bob"   | "company"
 "bob"   | "country"
(3 rows)

