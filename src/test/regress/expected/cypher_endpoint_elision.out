               ->  Index Scan using e2_start_idx on e2 d
               ->  Index Scan using e3_start_idx on e3 g
                     Index Cond: (start = d."end")
                     Filter: (d.id <> id)
         ->  Sort
               Sort Key: b."end"
               ->  Hash Join
                     Hash Cond: (b.start = a.id)
                     ->  Seq Scan on e1 b
                     ->  Hash
                           ->  Seq Scan on n1 a
   ->  Hash
         ->  Seq Scan on n4 h
