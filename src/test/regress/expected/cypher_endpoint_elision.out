-- referenced in WHERE (single-relation baserestrictinfo)
EXPLAIN (costs off) MATCH (a:person)-[:knows]->(x) WHERE x.name = 'bob' RETURN a.name AS a;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Nested Loop
   ->  Hash Join
         Hash Cond: ("<0000000092>"."end" = x.id)
         ->  Seq Scan on knows "<0000000092>"
