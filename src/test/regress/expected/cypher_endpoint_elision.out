-- intermediate elision is likewise structural
EXPLAIN (costs off) MATCH (a:person)-[]->()-[]->(c) RETURN a.name AS a, label(c) AS c;
                                       QUERY PLAN                                       
----------------------------------------------------------------------------------------
 Merge Join
   Merge Cond: ("<0000000079>".start = "<0000000077>"."end")
   Join Filter: ("<0000000077>".id <> "<0000000079>".id)
   ->  Nested Loop
         ->  Merge Append
               Sort Key: "<0000000079>".start, "<0000000079>"."end"
               ->  Index Scan using ag_edge_start_idx on ag_edge "<0000000079>_1"
               ->  Index Scan using knows_start_idx on knows "<0000000079>_2"
               ->  Index Scan using lives_in_start_idx on lives_in "<0000000079>_3"
               ->  Index Scan using works_at_start_idx on works_at "<0000000079>_4"
               ->  Index Scan using located_in_start_idx on located_in "<0000000079>_5"
         ->  Append
               ->  Seq Scan on ag_vertex c_1
                     Filter: (id = "<0000000079>"."end")
               ->  Index Scan using person_pkey on person c_2
                     Index Cond: (id = "<0000000079>"."end")
               ->  Index Scan using city_pkey on city c_3
                     Index Cond: (id = "<0000000079>"."end")
               ->  Index Scan using company_pkey on company c_4
                     Index Cond: (id = "<0000000079>"."end")
               ->  Index Scan using country_pkey on country c_5
                     Index Cond: (id = "<0000000079>"."end")
   ->  Sort
         Sort Key: "<0000000077>"."end"
         ->  Hash Join
               Hash Cond: ("<0000000077>".start = a.id)
               ->  Append
                     ->  Seq Scan on ag_edge "<0000000077>_1"
                     ->  Seq Scan on knows "<0000000077>_2"
                     ->  Seq Scan on lives_in "<0000000077>_3"
                     ->  Seq Scan on works_at "<0000000077>_4"
                     ->  Seq Scan on located_in "<0000000077>_5"
               ->  Hash
                     ->  Seq Scan on person a
