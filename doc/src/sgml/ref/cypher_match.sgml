<!--
doc/src/sgml/ref/cypher_match.sgml
PostgreSQL documentation
-->

<refentry id="cypher-match">
 <indexterm zone="cypher-match">
  <primary>MATCH</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>MATCH</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>MATCH</refname>
  <refpurpose>describes the graph pattern</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
[ OPTIONAL ] MATCH <replaceable class="parameter">path_pattern</replaceable> 
  [ WHERE expression ]
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
    The <command>MATCH</command> clause is a clause that describes the graph pattern you want to find in the
    database. This is the most basic way to import data.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
  <variablelist>
   <varlistentry>
    <term><literal>OPTIONAL</literal></term>
    <listitem>
     <para>
      The OPTIONAL MATCH clause, like the MATCH clause, is a clause describing the graph
      pattern to be searched. The OPTIONAL MATCH clause differs from the MATCH clause in
      that it returns NULL if there are no results to return.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">path_pattern</replaceable> </term>
    <listitem>
     <para>
      The graph pattern to be searched is described in the MATCH clause.
      See both below example section and <xref linkend="cypher-path"/> for more details.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">expression</replaceable></term>
    <listitem>
     <para>
      where <replaceable class="parameter">expression</replaceable> is
      any expression that evaluates to a result of type
      <type>boolean</type>.  Any row that does not satisfy this
      condition will be eliminated from the output.  A row satisfies the
      condition if it returns true when the actual row values are
      substituted for any variable references.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>
  <para>
   To search with OPTIONAL MATCH:
<programlisting>
OPTIONAL MATCH (e:person {name:'Emily'})
RETURN e.hobby;
</programlisting>
  </para>

  <para>
   To find a vertex:
<programlisting>
MATCH (j {name: 'Jack'})
RETURN j;
</programlisting>
  </para>

  <para>
   To find a edge:
<programlisting>
MATCH (j {name: 'Jack'})-[k:knows]->(e)
RETURN k;
</programlisting>
  </para>

  <para>
   To find a property:
<programlisting>
MATCH (j {name: 'Jack'})
RETURN j.age;
</programlisting>
  </para>

  <para>
   To find a path:
<programlisting>
MATCH p=(j {name: 'Jack'})-[k:knows]->(e)
RETURN p;
</programlisting>
  </para>

  <para>
   Delete a vertex:
<programlisting>
MATCH (m:person {name: 'Michael'})
DELETE m;
</programlisting>
  </para>

  <para>
   Delete an edge:
<programlisting>
MATCH (m:person {name: 'Michael'})-[l:likes]->(b:person {name: 'Bella'})
DELETE l;
</programlisting>
  </para>

  <para>
   Add a property:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.habit = 'play the guitar';
</programlisting>
  </para>

  <para>
   Modify property:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.name = 'Edward Williams';
</programlisting>
  </para>

  <para>
   Remove a property, Using SET:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.hobby = NULL;
</programlisting>
  </para>

  <para>
   Remove a property, Using REMOVE:
<programlisting>
MATCH (E:person {name: 'Edward'})
REMOVE E.habit;
</programlisting>
  </para>

  <para>
   To find a path using WITH clause:
<programlisting>
MATCH (j:person {name:'Jack'})-[:knows]-&gt;(common:person)&lt;-[:knows]-(other:person)
WITH other, count(common) AS cnt
WHERE to_jsonb(cnt) > 1
RETURN other;
</programlisting>
  </para>

  <para>
   Use "ONLY" to find result that excluding child label:
<programlisting>
MATCH (n:person ONLY) RETURN n;
MATCH ()-[r:knows ONLY]->() RETURN r;
</programlisting>
  </para>

  <para>
   To find a single shortest path between two verteices:
<programlisting>
MATCH p = shortestpath( (j:person {name: 'Jack'})-[l:knows*..15]-(a:person {name: 'Alice'}) )
RETURN p;
</programlisting>
  </para>

  <para>
   To find all shortest paths between two verteices:
<programlisting>
MATCH p = allshortestpaths( (j:person {name: 'Jack'})-[l:knows*]-(a:person {name: 'Alice'}) )
RETURN p;
</programlisting>
  </para>

  <para>
   To find a dijkstra shortest paths between two verteices:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3}),
      p=dijkstra((v2)-[e:e]-(v1), e.weight)
RETURN nodes(p);
</programlisting>
  </para>

  <para>
   To find an weighted dijkstra shortest paths between two verteices:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3})
RETURN dijkstra((v1)-[e:e]->(v2), e.weight, LIMIT 2);
</programlisting>
  </para>

  <para>
   To find a dijkstra shortest paths between two verteices with condition:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3}),
    p=dijkstra((v1)-[e:e]->(v2), e.weight, e.weight >= 5)
RETURN nodes(p);
</programlisting>
  </para>
 </refsect1>

  <refsect1>
  <title>See Also</title>
  <simplelist type="inline">
   <member><xref linkend="cypher-merge"/></member>
   <member><xref linkend="cypher-create"/></member>
  </simplelist>
 </refsect1>
</refentry>

