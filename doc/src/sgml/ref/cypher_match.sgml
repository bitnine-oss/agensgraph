<!--
doc/src/sgml/ref/cypher_match.sgml
PostgreSQL documentation
-->

<refentry id="cypher-match">
 <indexterm zone="cypher-match">
  <primary>MATCH</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>MATCH</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>MATCH</refname>
  <refname>OPTIONAL MATCH</refname>
  <refpurpose>project the cypher element</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>

[ OPTIONAL ] MATCH <replaceable class="parameter">path_pattern</replaceable> 
    [ WITH <replaceable class="parameter">cypher_expr</replaceable> [, ...] ]
    [ [ DETACH ] DELETE <replaceable class="parameter">cypher_expr</replaceable> [, ...] ]
    [ SET <replaceable class="parameter">cypher_expr</replaceable> { = | += } <replaceable class="parameter">cypher_expr</replaceable> [, ...] ]
    [ REMOVE <replaceable class="parameter">cypher_expr</replaceable> [, ...] ]
    [ WHERE <replaceable class="parameter">cypher_expr</replaceable> ]
     
<replaceable class="parameter">path_pattern</replaceable> can be one of:

    <replaceable class="parameter">cypher_path</replaceable> [, ...]
    <replaceable class="parameter">cypher_shortestpath</replaceable>
    <replaceable class="parameter">cypher_dijkstra</replaceable>

and <replaceable class="parameter">cypher_path</replaceable> is:

    <replaceable class="parameter">cypher_path_chain</replaceable>

and <literal>cypher_shortestpath</literal> can be one of:

    <literal>SHORTESTPATH</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> )
    <literal>ALLSHORTESTPATHS</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> )

and <literal>cypher_dijkstra</literal> can be one of:

    <literal>DIJKSTRA</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> , <replaceable class="parameter">weight</replaceable> )
    <literal>DIJKSTRA</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> , <replaceable class="parameter">weight</replaceable> , <replaceable class="parameter">condition</replaceable> )
    <literal>DIJKSTRA</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> , <replaceable class="parameter">weight</replaceable> , <literal>LIMIT</literal> <replaceable class="parameter">count</replaceable> )
    <literal>DIJKSTRA</literal> ( <replaceable class="parameter">cypher_path_chain</replaceable> , <replaceable class="parameter">weight</replaceable> , <replaceable class="parameter">condition</replaceable>, <literal>LIMIT</literal> <replaceable class="parameter">count</replaceable>)

and <replaceable class="parameter">cypher_path_chain</replaceable> can be one of:

    <replaceable class="parameter">node_pattern</replaceable>
    <replaceable class="parameter">cypher_path_chain</replaceable> <replaceable class="parameter">edge_pattern</replaceable> <replaceable class="parameter">node_pattern</replaceable>

and <replaceable class="parameter">node_pattern</replaceable> is:

    ( [<replaceable class="parameter">variable_name</replaceable>][<replaceable class="parameter">:label_name</replaceable>] [ ONLY ] [ <replaceable class="parameter">cypher_property_map</replaceable>] )

and <replaceable class="parameter">edge_pattern</replaceable> is:

    <replaceable class="parameter">cypher_relationship_left</replaceable> [ [<replaceable class="parameter">variable_name</replaceable>][<replaceable class="parameter">:label_name</replaceable>] [ONLY] [ <replaceable class="parameter">cypher_range_pattern</replaceable> ] [ <replaceable class="parameter">cypher_property_map</replaceable> ] ] <replaceable class="parameter">cypher_relationship_right</replaceable>

and <replaceable class="parameter">cypher_property_map</replaceable> is:

    { <replaceable class="parameter">property_name</replaceable> : <replaceable class="parameter">property_value</replaceable>, [ ...] }

and <replaceable class="parameter">cypher_range_pattern</replaceable> is:

    <literal>*</literal> [ [ minimum_hop ] .. [ maximum_hop ] ]

and <replaceable class="parameter">cypher_relationship_left</replaceable> is:
    
    { - | &lt;- }

and <replaceable class="parameter">cypher_relationship_right</replaceable> is:
    { - | -&gt; }

</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>

  <para>
    The <command>MATCH</command> clause finds the graph element that you described.

    For more information on the cypher path pattern specification, See <xref linkend="cypher-path-pattern"/>.
  </para>

 </refsect1>


 <refsect1>
  <title>Parameters</title>

  <variablelist>

   <varlistentry>
    <term><literal>OPTIONAL</literal></term>
    <listitem>
     <para>
      The OPTIONAL MATCH clause, like the MATCH clause, is a clause describing the graph
      pattern to be searched. The OPTIONAL MATCH clause differs from the MATCH clause in
      that it returns NULL if there are no results to return.
     </para>
    </listitem>
   </varlistentry>


   <varlistentry>
    <term><replaceable class="parameter">variable_name</replaceable></term>
    <listitem>
     <para>
      The variable name of the pattern. It can be a name of node, edge, path.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">label_name</replaceable></term>
    <listitem>
     <para>
      The label name of the pattern. 
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>ONLY</literal></term>
    <listitem>
     <para>
      The MATCH clause with keyword <literal>ONLY</literal> allows you to use the MATCH query to return results 
      that exclude child labels.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">property_name</replaceable></term>
    <listitem>
     <para>
      The key of property. 
      Key string can be one of the single quoted or double quoted or just a string without quotation.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">property_value</replaceable></term>
    <listitem>
     <para>
      The value of the property key. It could be a text, numeric, boolean.
      It follows the json rule. See <xref linkend="datatype-json"/>
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">weight</replaceable></term>
    <listitem>
     <para>
      The weight of the edge in the path. 
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">minimum_hop</replaceable></term>
    <listitem>
     <para>
      Integer constant representing the minimum hop count of the connected edge.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">maximum_hop</replaceable></term>
    <listitem>
     <para>
      Integer constant representing the maximum hop count of the connected edge.
     </para>
    </listitem>
   </varlistentry>

  </variablelist>
 
  <refsect2 id="cypher-with-clause" xreflabel="WITH Clause">
   <title><literal>WITH</literal> Clause</title>

   <para>
    The optional <literal>WITH</literal> clause has the general form
<synopsis>
WITH [ DISTINCT ] { <replaceable class="parameter">cypher_expr</replaceable> | <replaceable class="parameter">cypher_expr AS alias</replaceable> | * }
[ ORDER BY cypher_sort_items ]
[ SKIP cypher_expr ]
[ LIMIT cypher_expr ]
[ WHERE cypher_expr ]
</synopsis>
    The WITH clause is a clause that connects multiple cypher queries. It passes the result of
the preceding WITH clause query to the following WITH clause query. That is, the WITH
clause can be regarded as a RETURN clause that passes the value of the preceding query to
the input of the following query.
   </para>
  </refsect2>


  <refsect2 id="cypher-delete-clause" xreflabel="DELETE Clause">
   <title><literal>DELETE</literal> Clause</title>

   <para>
    The optional <literal>DELETE</literal> clause has the general form
<synopsis>
[DETACH] DELETE <replaceable class="parameter">cypher_expr</replaceable> [, ...]
</synopsis>
    The DELETE clause is a clause that removes vertices or edges.

    Find the vertices you want to remove through the MATCH clause and remove them by
    marking corresponding variables in the DELETE clause. However, if the vertices you
    want to remove are connected to other vertices and edges, remove the edges first
    before removing the vertices.

    Find the edges you want to remove with the MATCH clause and remove them by
    marking corresponding variables in the DELETE clause.

   </para>
  </refsect2>


  <refsect2 id="cypher-set-clause" xreflabel="SET Clause">
   <title><literal>SET</literal> Clause</title>

   <para>
    The optional <literal>SET</literal> clause has the general form
<synopsis>
SET <replaceable class="parameter">cypher_expr</replaceable> { = | += } <replaceable class="parameter">cypher_expr</replaceable>
</synopsis>
    The SET clause is a clause that adds, sets, or removes properties, or adds vlabels.
    Use the += operator to change existing properties of the vertex/edge or add new ones.
    You can set multiple properties using one SET clause, use the comma(,).
   </para>
  </refsect2>

  <refsect2 id="cypher-remove-clause" xreflabel="REMOVE Clause">
   <title><literal>REMOVE</literal> Clause</title>

   <para>
    The optional <literal>REMOVE</literal> clause has the general form
<synopsis>
REMOVE <replaceable class="parameter">cypher_expr</replaceable>
</synopsis>
    The REMOVE clause is a clause that removes properties.
    Locate the element from which you want to remove the property through the MATCH
    clause, and name the property to be removed in the REMOVE clause.
   </para>
  </refsect2>

  <refsect2 id="cypher-where-clause" xreflabel="WHERE Clause">
   <title><literal>WHERE</literal> Clause</title>

   <para>
    The optional <literal>WHERE</literal> clause has the general form
<synopsis>
WHERE <replaceable class="parameter">cypher_expr</replaceable>
</synopsis>
    The WHERE clause is a clause that adds constraints to the MATCH or OPTIONAL MATCH
clause or filters the results of the WITH clause. The WHERE clause cannot be used alone; it
is dependent on the MATCH, OPTIONAL MATCH, START, and WITH clauses when used.
You can use the boolean operators such as AND, OR.
   </para>
  </refsect2>


 
 </refsect1>




 <refsect1>
  <title>Examples</title>

  <para>
   To search with OPTIONAL MATCH:
<programlisting>
OPTIONAL MATCH (e:person {name:'Emily'})
RETURN e.hobby;
</programlisting>
  </para>

  <para>
   To find a vertex, edge:
<programlisting>
MATCH (j {name: 'Jack'})
RETURN j;

MATCH (j {name: 'Jack'})-[k:knows]->(e)
RETURN k;
</programlisting>
  </para>

  <para>
   To find a property:
<programlisting>
MATCH (j {name: 'Jack'})
RETURN j.age;
</programlisting>
  </para>

  <para>
   To find a path:
<programlisting>
MATCH p=(j {name: 'Jack'})-[k:knows]->(e)
RETURN p;
</programlisting>
  </para>



  <para>
   Delete a vertex:
<programlisting>
MATCH (m:person {name: 'Michael'})
DELETE m;
</programlisting>
  </para>

  <para>
   Delete an edge:
<programlisting>
MATCH (m:person {name: 'Michael'})-[l:likes]->(b:person {name: 'Bella'})
DELETE l;
</programlisting>
  </para>

  <para>
   Add a property:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.habit = 'play the guitar';
</programlisting>
  </para>

  <para>
   Modify property:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.name = 'Edward Williams';
</programlisting>
  </para>

  <para>
   Remove a property, Use SET or REMOVE:
<programlisting>
MATCH (E:person {name: 'Edward'})
SET E.hobby = NULL;

MATCH (E:person {name: 'Edward'})
REMOVE E.habit;
</programlisting>
  </para>

  <para>
   To find a path using WITH clause:
<programlisting>
MATCH (j:person {name:'Jack'})-[:knows]-&gt;(common:person)&lt;-[:knows]-(other:person)
WITH other, count(common) AS cnt
WHERE to_jsonb(cnt) > 1
RETURN other;
</programlisting>
  </para>

  <para>
   To find a single shortest path between two verteices:
<programlisting>
MATCH p = shortestpath( (j:person {name: 'Jack'})-[l:knows*..15]-(a:person {name: 'Alice'}) )
RETURN p;
</programlisting>
  </para>

  <para>
   To find all shortest paths between two verteices:
<programlisting>
MATCH p = allshortestpaths( (j:person {name: 'Jack'})-[l:knows*]-(a:person {name: 'Alice'}) )
RETURN p;
</programlisting>
  </para>

  <para>
   To find a dijkstra shortest paths between two verteices:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3}),
      p=dijkstra((v2)-[e:e]-(v1), e.weight)
RETURN nodes(p);
</programlisting>
  </para>

  <para>
   To find an weighted dijkstra shortest paths between two verteices:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3})
RETURN dijkstra((v1)-[e:e]->(v2), e.weight, LIMIT 2);
</programlisting>
  </para>

  <para>
   To find a dijkstra shortest paths between two verteices with condition:
<programlisting>
MATCH (v1:v {id: 0}), (v2:v {id: 3}),
    p=dijkstra((v1)-[e:e]->(v2), e.weight, e.weight >= 5)
RETURN nodes(p);
</programlisting>
  </para>

 </refsect1>

  <refsect1>
  <title>See Also</title>

