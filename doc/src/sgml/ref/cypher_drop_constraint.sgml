<!--
doc/src/sgml/ref/drop_constraint.sgml
PostgreSQL documentation
-->

<refentry id="cypher-dropconstraint">
 <indexterm zone="cypher-dropconstraint">
  <primary>DROP CONSTRAINT</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>DROP CONSTRAINT</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>DROP CONSTRAINT</refname>
  <refpurpose>drop a constraint of vertex/edge label</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
DROP CONSTRAINT <replaceable class="parameter">constraint_name</replaceable> ON <replaceable class="parameter">label_name</replaceable>
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>

  <para>
   <command>DROP CONSTRAINT</command> drop a constraint of the vertex/edge
  </para>

 </refsect1>

 <refsect1>
  <title>Parameters</title>

   <variablelist>

    <varlistentry>
     <term><replaceable class="parameter">constraint_name</replaceable></term>
     <listitem>
      <para>
       The <replaceable class="parameter">constraint_name</replaceable> should be provided for dropping.
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><replaceable class="parameter">label_name</replaceable></term>
     <listitem>
      <para>
       The <replaceable class="parameter">label_name</replaceable> is the target label to be dropped the constraint.
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>

  <para>
   To drop the label constraints:
<programlisting>

-- Drop constraint to the vertex label
DROP CONSTRAINT id_unique_constraint ON person;

</programlisting>
  </para>
 </refsect1>
 <refsect1>
  <title>See Also</title>

  <simplelist type="inline">
   <member><xref linkend="cypher-createconstraint"/></member>
  </simplelist>
 </refsect1>
</refentry>
