<!--
doc/src/sgml/ref/cypher_merge.sgml
PostgreSQL documentation
-->

<refentry id="cypher-merge">
 <indexterm zone="cypher-merge">
  <primary>CYPHER MERGE</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>MERGE</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>MERGE</refname>
  <refpurpose>merge the cypher elements to target</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
MERGE <replaceable class="parameter">path_pattern</replaceable> 
    [ ON { CREATE | MATCH } SET <replaceable class="parameter">set_expression</replaceable> [ , ... ] ] [ ... ]
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
   The <command>MERGE</command> clause is a clause that 
     <orderedlist>
       <listitem><para>If the specified pattern does not exist in the graph, adds a corresponding pattern (like the CREATE clause)</para></listitem>
       <listitem><para>If it already exists in the graph, verifies existence of the pattern (like the Match clause).</para></listitem>
     </orderedlist>
   The MERGE clause recognizes the entire pattern specified in the clause.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
   <variablelist>
    <varlistentry>
     <term><replaceable class="parameter">path_pattern</replaceable> </term>
     <listitem>
      <para>
       The graph pattern to be searched is described in the clause.
       See both below example section and <xref linkend="cypher-path"/> for more details.
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><literal>ON CREATE SET</literal></term>
     <listitem>
      <para>
       If the MERGE clause behaves like a <literal>CREATE</literal> clause, the <literal>ON CREATE SET</literal> clause will be performed.
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><literal>ON MATCH SET</literal></term>
     <listitem>
      <para>
       If the MERGE clause behaves like a <literal>MATCH</literal> clause, the <literal>ON MATCH SET</literal> clause will be performed.
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><replaceable class="parameter">set_expression</replaceable></term>
     <listitem>
      <para>
       The set expression for SET operation. It's a subset clause of MERGE statement.
       See both below example section and <xref linkend="cypher-set"/> for more details.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>
  <para>
   To merge a vertex:
<programlisting>
MERGE (:person {name: 'Edward'});
</programlisting>
  </para>

  <para>
   To merge a path:
<programlisting>
MERGE (E:person {name: 'Edward'})-[L:likes]->(A:person {name: 'Alice'})
RETURN E, L, A;
</programlisting>
  </para>

  <para>
   To merge a path but step by step merge:
<programlisting>
MERGE (E:person {name: 'Edward'})
MERGE (A:person {name: 'Alice'})
MERGE (E)-[L:likes]->(A)
RETURN E, L, A;
</programlisting>
  </para>

  <para>
   To merge a vertex with <literal>ON CREATE SET</literal> and <literal>ON MATCH SET</literal>:
<programlisting>
-- Vertex will be newly merged:
MERGE (E:person {name: 'Edward'})
ON CREATE SET E.lastop = 'CREATE'
ON MATCH SET E.lastop = 'MATCH'
RETURN E.lastop;
  lastop  
----------
 "CREATE"
(1 row)

-- Do the same query again:
MERGE (E:person {name: 'Edward'})
ON CREATE SET E.lastop = 'CREATE'
ON MATCH SET E.lastop = 'MATCH'
RETURN E.lastop;
  lastop  
----------
 "MATCH"
(1 row)
</programlisting>
  </para>
 </refsect1>

  <refsect1>
  <title>See Also</title>
  <simplelist type="inline">
   <member><xref linkend="cypher-match"/></member>
   <member><xref linkend="cypher-create"/></member>
  </simplelist>
 </refsect1>
</refentry>
