<!--
doc/src/sgml/ref/cypher_remove.sgml
PostgreSQL documentation
-->

<refentry id="cypher-remove">
 <indexterm zone="cypher-remove">
  <primary>REMOVE</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>REMOVE</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>REMOVE</refname>
  <refpurpose>remove properties</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
REMOVE <replaceable class="parameter">expression</replaceable> [ , ... ]
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
   A <command>REMOVE</command> is a terminal clause. It will remove properties from target label or elements.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
  <variablelist>
   <varlistentry>
    <term><literal>expression</literal></term>
    <listitem>
     <para>
      The property expression that will be removed. 
      See <xref linkend="cypher-expr"/> for more details.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>
  <para>
   To remove specified property:
<programlisting>
-- Remove property 'nickname' from matching vertex
MATCH (E:person {name: 'Edward'})
REMOVE E.nickname;
</programlisting>
  </para>
 </refsect1>
</refentry>
