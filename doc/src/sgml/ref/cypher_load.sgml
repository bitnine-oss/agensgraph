<!--
doc/src/sgml/ref/cypher_load.sgml
PostgreSQL documentation
-->

<refentry id="cypher-load">
 <indexterm zone="cypher-load">
  <primary>CYPHER LOAD</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>LOAD</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>LOAD</refname>
  <refpurpose>load data from table</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>

LOAD FROM <replaceable class="parameter">table_name</replaceable> AS <replaceable class="parameter">alias_name</replaceable>

</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
    load the table data into cypher query context using LOAD clause.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
  <variablelist>
   <varlistentry>
    <term><replaceable class="parameter">table_name</replaceable></term>
    <listitem>
     <para>
      The name of the table that to be loaded.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">alias_name</replaceable></term>
    <listitem>
     <para>
      The alias name that will be used in the cypher cluases.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>
  <para>
   To load data from table person to the vertex label person:
<programlisting>
LOAD FROM person AS v
CREATE (:person {id: v.id, name: v.name});
</programlisting>
  </para>

  <para>
   To load data from table friend to the edge label friend:
<programlisting>
LOAD FROM friend AS e
MATCH (a:person),(b:person)
WHERE id(a) = to_jsonb(e.start_id)
AND id(b) = to_jsonb(e.end_id)
CREATE (a)-[:friend {date: '2018'}]->(b);
</programlisting>
  </para>
 </refsect1>
</refentry>
