doc/src/sgml/ref/create_elabel.sgml
PostgreSQL documentation
-->

<refentry id="cypher-createelabel">
 <indexterm zone="cypher-createelabel">
  <primary>CREATE ELABEL</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>CREATE ELABEL</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>CREATE ELABEL</refname>
  <refpurpose>create the edge label</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>

CREATE [UNLOGGED] ELABEL [IF NOT EXISTS] <replaceable class="parameter">label_name</replaceable> [ option [ ... ] ]

where option can be:

    DISABLE INDEX
    INHERITS ( <replaceable class="parameter">label_name</replaceable> [, ... ] )
    WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] )
    TABLESPACE <replaceable class="parameter">tablespace_name</replaceable>

</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>

  <para>
   <command>CREATE ELABEL</command> statement creates the label of edge.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>

  <variablelist>
   <varlistentry>
    <term><literal>UNLOGGED</literal></term>
    <listitem>
     <para>
      If specified, the table of edge label is created as an unlogged table.  Refer
      to <xref linkend="sql-createtable"/> for details.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>IF NOT EXISTS</literal></term>
    <listitem>
     <para>
      Do not throw an error if a edge label with the same name already.
      exists;
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">label_name</replaceable></term>
    <listitem>
     <para>
      The name of the edge label that to be created.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>DISABLE INDEX</literal></term>
    <listitem>
     <para>
      This commmand will disable all indexes of the given graph label
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>INHERITS</literal></term>
    <listitem>
     <para>
      The optional <literal>INHERITS</literal> clause specify the names of the parent labels along with the
      corresponding keyword after the child label name. There can be multiple parent labels
      for inheritance.
        <note>
          <para>
            If you want to check the inheritance of the label, 
            You can use the <command>\d graph_name.label_name</command> command in the psql client.
<programlisting>
postgres=# CREATE ELABEL childElabelName inherits (parentElabelName1, parentElabelName2);
CREATE ELABEL
postgres=# \d g.childElabelName
                                                            Table "g.childelabelname"
   Column   |  Type   | Collation | Nullable |                                              Default                                              
------------+---------+-----------+----------+---------------------------------------------------------------------------------------------------
 id         | graphid |           | not null | graphid(graph_labid('g.childelabelname'::cstring), nextval('g.childelabelname_id_seq'::regclass))
 start      | graphid |           | not null | 
 end        | graphid |           | not null | 
 properties | jsonb   |           | not null | jsonb_build_object()
Indexes:
    "childelabelname_end_idx" btree ("end", start)
    "childelabelname_id_idx" brin (id)
    "childelabelname_start_idx" btree (start, "end")
Inherits: g.parentelabelname1,
          g.parentelabelname2
</programlisting>    
          </para>
        </note>
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] )</literal></term>
    <listitem>
     <para>
      This clause specifies optional storage parameters for a table or index;
      see <xref linkend="sql-createtable-storage-parameters"/> below for more
      information.  For backward-compatibility the <literal>WITH</literal>
      clause for a table can also include <literal>OIDS=FALSE</literal> to
      specify that rows of the new table should not contain OIDs (object
      identifiers), <literal>OIDS=TRUE</literal> is not supported anymore.
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>TABLESPACE</literal> <replaceable class="parameter">tablespace_name</replaceable></term>
    <listitem>
     <para>
      The <replaceable class="parameter">tablespace_name</replaceable> is the name
      of the tablespace in which the new label is to be created.
      If not specified, default_tablespace is consulted.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>

  <para>
   To create edge label:
<programlisting>
CREATE ELABEL elabelName;
</programlisting>
  </para>

  <para>
   To create edge label only if not exists in the graph:
<programlisting>
CREATE ELABEL if not exists elabelName;
</programlisting>
  </para>

  <para>
   To create edge label with inherits:
<programlisting>
CREATE ELABEL childElabelName inherits (parentElabelName1, parentElabelName2);
</programlisting>
  </para>

  <para>
   Create elable with disable index and specifying tablespace:
<programlisting>
CREATE ELABEL elab DISABLE INDEX TABLESPACE my_tablespace;
</programlisting>
  </para>
 </refsect1>

