<!--
doc/src/sgml/ref/cypher_skip.sgml
PostgreSQL documentation
-->

<refentry id="cypher-skip">
 <indexterm zone="cypher-skip">
  <primary>SKIP</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>SKIP</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>SKIP</refname>
  <refpurpose>skip the result of cypher query</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
SKIP <replaceable class="parameter">count</replaceable>
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
   SKIP clause will skip the number of result.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
  <variablelist>
   <varlistentry>
    <term><replaceable class="parameter">count</replaceable></term>
    <listitem>
     <para>
      Specify how many results will be skipped.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Examples</title>
  <para>
<programlisting>
UNWIND [ 1, 2, 3, 4, 5 ] as seq 
RETURN seq
SKIP 3;
 seq 
-----
 4
 5
(2 rows)
</programlisting>
  </para>
 </refsect1>
</refentry>
